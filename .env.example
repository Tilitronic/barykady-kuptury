# T-034 — environment variable inventory. NO REAL VALUES ARE COMMITTED.
#
# This file documents the names only. See docs/environment.md for where each
# value lives and which ones are browser-safe.
#
# LOCAL DEVELOPMENT
#   Copy only the VITE_* names below into apps/web/barykadyKultury/.env.local
#   (that is the file Vite/Quasar actually reads).
#
# SERVER-ONLY
#   Everything under "Netlify functions" belongs in the Netlify UI (site
#   environment variables) or an untracked local shell export. Never put these
#   in .env.local, never rename one to VITE_*: a VITE_ prefix inlines the value
#   into the browser bundle (AGENTS.md rule 4).

# ── Browser-safe (public by definition) ─────────────────────────────────────
# Supabase project URL and publishable/anon key. These are shipped to every
# visitor by design; access is controlled by RLS, not by hiding the key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Absolute public origin, e.g. https://example.org (no trailing slash).
# Used for canonical/og:url links and for sitemap generation at build time.
VITE_SITE_URL=

# ── Netlify functions (server-only) ─────────────────────────────────────────
# Supabase service-role access for functions only. Bypasses RLS — treat as a
# master credential. The browser never receives it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar read-only feed for the public events surfaces.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# Google Drive import/sync (T-041/T-042). The per-admin OAuth vault is the
# production path; the shared refresh token is a deprecated dev/demo fixture.
GOOGLE_IMPORT_AUTH_MODE=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_SHARED_DRIVE_FOLDER_ID=
# AES-256-GCM key for the encrypted refresh-token vault.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google Picker. Server-configured and returned to an authenticated admin, but
# NOT secret: the API key is referrer-restricted. Do not promote to VITE_*.
GOOGLE_PICKER_APP_ID=
GOOGLE_PICKER_API_KEY=

# Optional scheduled-sync override (default @daily).
CONTENT_SYNC_SCHEDULE=
