{
  "name": "barykadykultury",
  "version": "0.0.1",
  "private": true,
  "description": "Public website and admin panel for the Barykady Kultury association",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Rostyslav <tilimilitron@gmail.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@quasar/extras": "^2.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "hast-util-sanitize": "^5.0.2",
    "mammoth": "^1.13.0",
    "pinia": "^4.0.2",
    "quasar": "^2.35.1",
    "rehype-parse": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@playwright/test": "1.63.0",
    "@quasar/app-vite": "^3.10.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "happy-dom": "^21.0.3",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "supabase": "2.121.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "Barykady Kultury"
}
