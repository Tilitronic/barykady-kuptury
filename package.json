{
  "name": "barykady-kultury",
  "version": "0.1.0",
  "private": true,
  "description": "Repository root scripts for the Barykady Kultury website",
  "scripts": {
    "dev": "pnpm --dir apps/web/barykadyKultury dev",
    "build": "pnpm --dir apps/web/barykadyKultury build",
    "lint": "pnpm --dir apps/web/barykadyKultury lint",
    "lint:check": "pnpm --dir apps/web/barykadyKultury lint:check",
    "format": "pnpm --dir apps/web/barykadyKultury format",
    "format:check": "pnpm --dir apps/web/barykadyKultury format:check",
    "typecheck": "pnpm --dir apps/web/barykadyKultury typecheck",
    "test": "pnpm --dir apps/web/barykadyKultury test",
    "test:coverage": "pnpm --dir apps/web/barykadyKultury test:coverage",
    "test:e2e": "pnpm --dir apps/web/barykadyKultury test:e2e",
    "test:e2e:install": "pnpm --dir apps/web/barykadyKultury test:e2e:install",
    "test:db:idempotency": "node scripts/verify-seed-idempotency.mjs"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
